<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!-- LineageOS overrides -->
  <remove-project path="build/make" name="LineageOS/android_build" groups="pdk" />
  <project path="build/make" name="ArielOSProject/android_build" groups="pdk" remote="ariel">
   <copyfile src="core/root.mk" dest="Makefile" />
   <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
   <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
   <linkfile src="core" dest="build/core" />
   <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
   <linkfile src="target" dest="build/target" />
   <linkfile src="tools" dest="build/tools" />
  </project>
  <remove-project path="build/soong" name="LineageOS/android_build_soong" groups="pdk,tradefed" />
  <project path="build/soong" name="ArielOSProject/android_build_soong" groups="pdk,tradefed" remote="ariel" >
       <linkfile src="root.bp" dest="Android.bp" />
       <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <remove-project path="frameworks/base" name="LineageOS/android_frameworks_base" groups="pdk-cw-fs,pdk-fs" />
  <project path="frameworks/base" name="ArielOSProject/android_frameworks_base" groups="pdk-cw-fs,pdk-fs" remote="ariel"/>

  <!-- Forked so that we can manipulate incomming SMS before broadcasting -->
  <remove-project path="frameworks/opt/telephony" name="LineageOS/android_frameworks_opt_telephony" groups="pdk" />
  <project path="frameworks/opt/telephony" name="ArielOSProject/android_frameworks_opt_telephony" groups="pdk" remote="ariel"/>

  <!-- <remove-project path="packages/apps/SetupWizard" name="LineageOS/android_packages_apps_SetupWizard" />
  <project path="packages/apps/SetupWizard" name="ArielOSProject/android_packages_apps_SetupWizard" remote="ariel"/> -->

  <!-- ArielOS additions -->
  <project path="vendor/ariel" name="ArielOSProject/platform_vendor_ariel" remote="ariel" />
  <!-- <project path="vendor/ariel-priv" name="ArielOSProject/ariel-priv" remote="ariel_private" revision="master"/> -->
  <project path="vendor/ariel_gms" name="ArielOSProject/platform_vendor_ariel_gms" remote="github" revision="master" />
  <!-- apps are moved to vendor/ariel/packages/apps because of issues with building them with Android.bp -->
  <!-- 1. Starting from ariel-lineage-22.2 all apps under packages/apps must be ported to Android.bp -->
  <!-- 2. Using Android.bp it is not possible to differentiate eng vs userdebug build to decide which apk to use and we need that (could be done with soong module maybe) -->
  <!-- 3. Some APKs (AuroraStore) have compressed libs and Android.bp system doesnt like that; we didnt find a solution for it so moving apps to vendor -->
  <project path="vendor/ariel/packages/apps/ArielGuardian" name="ArielOSProject/android_packages_apps_ArielGuardian" remote="ariel" revision="master" />
  <project path="vendor/ariel/packages/apps/ArielParental" name="ArielOSProject/android_packages_apps_ArielParental" remote="ariel" revision="master" />
  <project path="vendor/ariel/packages/apps/AuroraStore" name="ArielOSProject/android_packages_apps_AuroraStore" remote="ariel" revision="master" />
  <project path="vendor/ariel/packages/apps/ArielProtector" name="ArielOSProject/android_packages_apps_ArielProtector" remote="ariel" revision="master" />
  <project path="vendor/ariel/packages/apps/NewPipe" name="ArielOSProject/android_packages_apps_NewPipe" remote="ariel" revision="master" />

</manifest>
